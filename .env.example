# Election Yatra — Environment Variables
# Copy to .env.local and fill in real values from Google Cloud Console / Secret Manager.

# -----------------------------------------------------------------------------
# Google Cloud project
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=election-yatra
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# -----------------------------------------------------------------------------
# llm-service / Antigravity AI (backend only)
# -----------------------------------------------------------------------------
LLM_SERVICE_ENABLED=true
LLM_SERVICE_URL=https://llm.lehana.in
LLM_SERVICE_ENDPOINT=antigravity-manager
LLM_SERVICE_MODEL=gemini-3-flash
LLM_SERVICE_PROVIDER=custom
LLM_SERVICE_PROVIDER_BASE_URL=https://antigravity.aidhunik.com/v1
LLM_SERVICE_BYOK=false
LLM_SERVICE_API_KEY=
LLM_SERVICE_INTERNAL_KEY=
LLM_SERVICE_TIMEOUT_MS=90000

# Legacy direct Gemini variables are not used by API routes.
VERTEX_MODEL_CHAT=gemini-3-flash
VERTEX_MODEL_ANALYSIS=gemini-3-flash
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Maps, Places, Geocoding, Directions, Distance Matrix
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# -----------------------------------------------------------------------------
# OAuth (Calendar)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -----------------------------------------------------------------------------
# YouTube Data API
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_SVEEP_PLAYLIST_ID=

# -----------------------------------------------------------------------------
# Translation, TTS, STT (use ADC via GOOGLE_APPLICATION_CREDENTIALS)
# -----------------------------------------------------------------------------
TRANSLATION_DEFAULT_SOURCE=en
TRANSLATION_SUPPORTED_LOCALES=en,hi,bn,ta,te,mr,gu,kn,ml,pa,ur

# -----------------------------------------------------------------------------
# Firebase
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=election-yatra
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# reCAPTCHA Enterprise
# -----------------------------------------------------------------------------
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_BYPASS=true
RECAPTCHA_BYPASS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# -----------------------------------------------------------------------------
# GA4 (server-side Measurement Protocol)
# -----------------------------------------------------------------------------
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# App config
# -----------------------------------------------------------------------------
NODE_ENV=development
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000
# Production default is false; set true only for trusted server-to-server or local no-Origin clients.
ALLOW_NO_ORIGIN_REQUESTS=true
# Set true only when you intentionally want scripted local demo behavior.
DEMO_MODE=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
